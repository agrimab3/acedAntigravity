# Local URL used by NextAuth/Auth.js during development. Set this to your app URL.
NEXTAUTH_URL=http://localhost:3000

# Auth.js session-signing secret. Generate a strong random value locally or in your hosting provider.
AUTH_SECRET=your_auth_secret_here

# Google OAuth client ID for sign-in. Get it from Google Cloud Console > APIs & Services > Credentials.
AUTH_GOOGLE_ID=your_google_oauth_client_id_here

# Google OAuth client secret for sign-in. Get it from Google Cloud Console > APIs & Services > Credentials.
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret_here

# PostgreSQL connection string. Get it from your database provider; keep the real password only in local/hosted env settings.
DATABASE_URL=postgresql://aced_app:your_password_here@127.0.0.1:54322/aced

# Gemini API key for content generation. Get it from Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name used by Aced. Choose a supported model from Google AI documentation.
GEMINI_MODEL=gemini-2.5-flash

# Groq API key for content generation. Get it from the Groq developer console.
GROQ_API_KEY=your_groq_api_key_here

# Groq model name used by Aced. Choose a supported model from the Groq developer console/docs.
GROQ_MODEL=llama-3.3-70b-versatile

# Mock Test authentication mode. Use "test" locally; switch to the launch auth mode in hosted env settings.
MOCK_TEST_AUTH_MODE=test

# Mock Test payment mode. Use "test" locally; switch to the launch payment mode in hosted env settings.
MOCK_TEST_PAYMENT_MODE=test

# Comma-separated owner/admin email addresses. Set these to the authorized accounts for your deployment.
ADMIN_EMAILS=owner@example.com

# Desmos API key used by the browser calculator. Get it from Desmos API access/settings.
NEXT_PUBLIC_DESMOS_API_KEY=your_desmos_api_key_here
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Resend email delivery. In local/dev, every message is redirected to EMAIL_TEST_TO.
RESEND_API_KEY=
EMAIL_TEST_TO=
EMAIL_FROM=onboarding@resend.dev
