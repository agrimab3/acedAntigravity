{
  "name": "aced",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:question-review": "node --test --experimental-strip-types scripts/question-review.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env scripts/seed-core.mjs",
    "questions:generate": "node --env-file=.env generate-questions.mjs",
    "content:backlog": "node --env-file=.env scripts/run-content-backlog.mjs",
    "content:critical": "node --experimental-specifier-resolution=node --env-file=.env scripts/fill-critical-backlog.mts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.2.2",
    "next-auth": "^4.24.13",
    "pg": "^8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
