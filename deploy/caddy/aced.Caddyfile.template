aceditprep.com {
  @public path / /how-it-works /sections /faq /about /join /terms /privacy /refunds /contact /favicon.ico /icon.svg /apple-icon.png
  @publicForms path /api/waitlist-signups /api/join-requests
  @publicStatic path /_next/static/* /fonts/* /images/*
  @webhook path /api/stripe/webhook*

  handle @public {
    reverse_proxy 127.0.0.1:3005
  }

  handle @publicStatic {
    reverse_proxy 127.0.0.1:3005
  }

  handle @publicForms {
    reverse_proxy 127.0.0.1:3005
  }

  handle @webhook {
    reverse_proxy 127.0.0.1:3005
  }

  handle {
    # Temporary pre-launch gate. Replace HASH_FROM_CADDY with:
    # caddy hash-password --plaintext 'your-password'
    basicauth {
      aced HASH_FROM_CADDY
    }
    reverse_proxy 127.0.0.1:3005
  }
}

www.aceditprep.com {
  redir https://aceditprep.com{uri} permanent
}
