aceditprep.com {
  # These routes enforce their own application authentication where needed.
  # Keep the catch-all handle below protected by Caddy Basic Auth.
  @public path / /signin /legal /how-it-works /sections /faq /about /join /terms /privacy /refunds /mock-test-rules /accessibility /contact /favicon.ico /icon.svg /apple-icon.png /api/health /api/auth/* /mock-test /mock-test/* /api/mock-test/*
  @publicForms path /api/waitlist-signups /api/join-requests
  @publicStatic path /_next/static/* /fonts/* /images/* /starmap.jpg /const-english.jpg /const-math.jpg /const-reading.jpg /const-science.jpg
  @webhook path /api/stripe/webhook*

  handle @public {
    reverse_proxy 127.0.0.1:3005
  }

  handle @publicStatic {
    reverse_proxy 127.0.0.1:3005
  }

  handle @publicForms {
    reverse_proxy 127.0.0.1:3005
  }

  handle @webhook {
    reverse_proxy 127.0.0.1:3005
  }

  handle {
    # Temporary pre-launch gate. Replace HASH_FROM_CADDY with:
    # caddy hash-password --plaintext 'your-password'
    basicauth {
      aced HASH_FROM_CADDY
    }
    reverse_proxy 127.0.0.1:3005
  }
}

www.aceditprep.com {
  redir https://aceditprep.com{uri} permanent
}
